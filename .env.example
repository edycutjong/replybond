# ReplyBond environment. Copy this file to .env and fill in the values.
# Placeholders only: never commit real keys. Commented-out lines are optional.

# --- api/ (server functions) ---------------------------------------------------

# The two demo wallets' private keys. Required.
PROVIDER_KEY=<provider-wallet-private-key>
DEMO_BUYER_KEY=<demo-buyer-wallet-private-key>

# RPC endpoint for the configured chain. Required in production.
RPC_URL=<rpc-endpoint-url>

# Optional overrides of VITE_REPLYBOND_ADDRESS and VITE_REPLYBOND_START_BLOCK for the api/ functions.
# REPLYBOND_ADDRESS=<replybond-contract-address>
# REPLYBOND_START_BLOCK=<deployment-block-number>

# Optional. When set, only the cron's bearer token triggers pool rotation in /api/demo-refill.
# CRON_SECRET=<random-secret>

# Set by Arc Studio previews; optional elsewhere.
# RPC_PROXY_BASE_URL=<rpc-proxy-base-url>
# RPC_PROXY_TOKEN=<rpc-proxy-token>
# RPC_PROXY_CHAINS=<comma-separated-chain-names>

# --- page and api/ -------------------------------------------------------------

# Which chain and which deployment. Required in production.
VITE_CHAIN_ID=<chain-id>
VITE_REPLYBOND_ADDRESS=<replybond-contract-address>
VITE_REPLYBOND_START_BLOCK=<deployment-block-number>

# --- page ----------------------------------------------------------------------

# Optional. Lets the page list the provider's jobs without waiting for the sweep.
# VITE_PROVIDER_ADDRESS=<provider-wallet-address>
# VITE_DEMO_BUYER_ADDRESS=<demo-buyer-wallet-address>

# Optional. A settled timeout for the hero when the recent scan finds none.
# VITE_PROOF_TIMEOUT_TX=<settled-timeout-transaction-hash>

# --- build ---------------------------------------------------------------------

# Optional. The project link in the header.
# VITE_STUDIO_PROJECT_URL=<studio-project-url>
# Optional. The public origin of the site, used for the social card.
# VITE_SITE_URL=<https://your-domain>

# --- server/ (local only) ------------------------------------------------------

# Local only, for the sample /api/probe route (bun run server).
# PROBE_KEY=<probe-wallet-private-key>
# PROBE_SERVER_PORT=<port>
